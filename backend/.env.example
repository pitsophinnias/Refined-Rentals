# Database
# Either set DATABASE_URL (used on Render) or the discrete DB_* vars below (local dev)
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=refined_rentals
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=replace_with_a_random_32+_character_secret
JWT_EXPIRES_IN=8h

# Server
PORT=3001

# Admin seed credentials — only used the first time `npm run seed` is run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# File uploads
UPLOAD_DIR=uploads/gallery
MAX_FILE_SIZE_MB=50

# Environment
NODE_ENV=development

# Additional allowed CORS origins (comma-separated, for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Email (Resend) — new quote request + quote-sent notifications
# Get a key at https://resend.com — sending is skipped with a warning if unset
RESEND_API_KEY=re_your_resend_api_key
NOTIFY_EMAIL=notifications@example.com
